label{display:block;font-size:12px;font-weight:700;margin:15px 0 8px}input{width:100%;padding:14px;border:1px solid #8bb5d655;border-radius:11px;background:#f5faff;color:#06172f;font-size:14px;outline:none}input:focus{border-color:var(--ice);box-shadow:0 0 0 3px #54d8ff28}.primary{width:100%;margin-top:20px;padding:14px;border:0;border-radius:11px;background:linear-gradient(100deg,var(--ice),#168cf5 60%,var(--orange));color:#06172f;font-weight:900}.reset{display:block;margin:15px auto 0;border:0;background:none;color:#a9dcff;text-decoration:underline;font-size:11px;font-weight:700}#loginStatus{min-height:22px;color:#ffd0a8;font-size:11px;text-align:center;line-height:1.5}.secure{text-align:center;color:#829fbd;font-size:10px;margin-top:16px}
