    <div class="toolbar"><input class="search" id="bookingSearch" placeholder="Search name, phone, service or address…"><select class="filter" id="bookingFilter"><option value="all">All statuses</option><option>Pending</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option></select></div>
    <div class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>CUSTOMER</th><th>SERVICE / DATE</th><th>CONTACT / ADDRESS</th><th>STATUS</th><th>UPDATE STATUS</th></tr></thead><tbody id="bookingRows"><tr><td colspan="5" class="empty">Loading bookings…</td></tr></tbody></table></div></div>
   </section>

