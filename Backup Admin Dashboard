.two-col{display:grid;grid-template-columns:1.3fr .9fr;gap:14px;margin-top:14px}.panel{padding:18px;min-width:0}.panel h2{font-size:15px;margin:0 0 14px}.timebox{text-align:center;padding:16px;border-radius:14px;background:linear-gradient(135deg,#0b3158,#071a32);border:1px solid #42cfff44}.bigclock{font-size:clamp(28px,5vw,43px);font-weight:900;letter-spacing:1px;color:var(--ice);font-variant-numeric:tabular-nums}.date-line{font-size:12px;color:#c5d8e9;margin-top:5px}.calendar-head{display:flex;justify-content:space-between;align-items:center;margin:16px 0 10px}.calendar-head strong{font-size:12px}.calnav{border:1px solid var(--line);background:#102e50;color:var(--ice);border-radius:8px;padding:5px 9px}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center}.calendar span{font-size:10px;color:var(--muted);padding:7px 0}.calendar button{border:0;background:#102e50;color:#eaf6ff;border-radius:8px;padding:8px 0;font-size:10px}.calendar button.today{background:var(--orange);color:#07172d;font-weight:900}.calendar button:disabled{opacity:0;cursor:default}
.section{display:none}.section.active{display:block}.toolbar{display:flex;flex-wrap:wrap;gap:9px;margin:0 0 14px}.search{flex:1;min-width:180px;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:#071a31;color:white;font-size:12px}.filter{padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#0d2949;color:#eaf6ff;font-size:11px}.table-wrap{overflow-x:auto}.data-table{width:100%;border-collapse:collapse;min-width:700px}.data-table th{text-align:left;color:var(--muted);font-size:10px;letter-spacing:.7px;padding:11px 9px;border-bottom:1px solid var(--line)}.data-table td{padding:13px 9px;border-bottom:1px solid #29435e;font-size:11px;vertical-align:top}.data-table tr:last-child td{border-bottom:0}.sub{display:block;color:var(--muted);font-size:10px;margin-top:4px;line-height:1.5}.status-badge{display:inline-block;padding:5px 8px;border-radius:99px;font-size:9px;font-weight:800;background:#ffffff13;color:#d8e8f6}.status-Pending,.status-pending{color:#ffd08b;background:#ff941f1b}.status-Confirmed,.status-approved{color:#75e7c1;background:#20c9971b}.status-Completed{color:#8edaff;background:#42cfff1b}.status-Cancelled,.status-rejected{color:#ff9ba2;background:#ff6b751b}.action{border:1px solid #42cfff55;background:#42cfff12;color:var(--ice);border-radius:8px;padding:7px 9px;font-size:10px;font-weight:800;margin:2px}.action.approve{border-color:#20c99766;background:#20c99716;color:#75e7c1}.action.reject{border-color:#ff6b7566;background:#ff6b7516;color:#ff9ba2}.empty{padding:28px;text-align:center;color:var(--muted);font-size:12px}.note{color:var(--muted);font-size:10px;line-height:1.6;margin-top:12px}.welcome-panel{padding:22px;margin-bottom:14px;border-radius:18px;border:1px solid #42cfff55;background:linear-gradient(110deg,#0d3156,#0a2341 60%,#163b35)}.welcome-panel h2{font-size:22px;margin:0 0 7px}.welcome-panel h2 span{color:var(--ice)}.welcome-panel p{font-size:12px;color:#c4d8e8;margin:0}.toast{position:fixed;right:18px;bottom:18px;z-index:20;padding:12px 16px;border-radius:11px;background:#123b36;border:1px solid #20c997;color:#b9ffe7;font-size:11px;box-shadow:0 10px 30px #0006;display:none}
@media(max-width:850px){.shell{grid-template-columns:1fr;padding:14px}.sidebar{position:static;display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:7px}.navbtn{justify-content:center;padding:10px 5px;font-size:10px}.navbtn .ico{width:auto}.navbtn .txt{display:none}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two-col{grid-template-columns:1fr}.topbar{padding:10px 13px}.topbrand strong{font-size:14px}.clock-small{display:none}}
