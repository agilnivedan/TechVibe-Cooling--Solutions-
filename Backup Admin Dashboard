     <div class="panel"><h2>Recent Bookings</h2><div id="recentBookings" class="empty">Loading bookings…</div></div>
     <div class="panel"><h2>Live Clock & Calendar</h2><div class="timebox"><div class="bigclock" id="bigClock">--:--:--</div><div class="date-line" id="dateLine">Loading date…</div></div><div class="calendar-head"><button class="calnav" id="prevMonth" aria-label="Previous month">‹</button><strong id="calendarTitle">Month Year</strong><button class="calnav" id="nextMonth" aria-label="Next month">›</button></div><div class="calendar" id="calendarGrid"></div></div>
    </div>
   </section>

   <section id="page-bookings" class="section">
