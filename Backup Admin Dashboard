 <header class="topbar">
  <div class="topbrand"><img src="https://agilnivedan.github.io/TechVibe-Cooling--Solutions-/techvibe-logo.jpg" alt="TechVibe" onerror="this.onerror=null;this.src='https://agilnivedan.github.io/TechVibe-Cooling--Solutions-/logo.png'"><div><strong>TechVibe Cooling Solutions</strong><small>ADMINISTRATION DASHBOARD</small></div></div>
  <div class="top-actions"><span class="clock-small" id="topClock">--:--:--</span><button class="logout" id="logoutBtn">SIGN OUT</button></div>
 </header>
 <div class="shell">
  <nav class="sidebar">
