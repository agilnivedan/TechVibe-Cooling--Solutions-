<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/13.2.0/firebase-app.js";
import {getAuth,signInWithEmailAndPassword,sendPasswordResetEmail,onAuthStateChanged,signOut} from "https://www.gstatic.com/firebasejs/13.2.0/firebase-auth.js";
import {getFirestore,collection,onSnapshot,doc,updateDoc} from "https://www.gstatic.com/firebasejs/13.2.0/firebase-firestore.js";

const firebaseConfig={apiKey:"AIzaSyA5YrTXH3UIUX-PimEQ05X6HDgXp-jr4kc",authDomain:"techvibe-cooling-solutions.firebaseapp.com",projectId:"techvibe-cooling-solutions",storageBucket:"techvibe-cooling-solutions.firebasestorage.app",messagingSenderId:"371234823181",appId:"1:371234823181:web:0264f0c0e944a52d7e0944",measurementId:"G-8LK4NTF02B"};
const ADMIN_UID="cKuGCz2tbmYqT05fCXdrfTQ3fry1";
const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getFirestore(app);
const $=id=>document.getElementById(id);
let bookings=[],reviews=[],calendarDate=new Date(),stopBookings=null,stopReviews=null,toastTimer;
const localDate=new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Colombo",weekday:"long",year:"numeric",month:"long",day:"numeric"});
function greeting(){const h=Number(new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Colombo",hour:"2-digit",hourCycle:"h23"}).format(new Date()));return h>=5&&h<12?"Good morning":h>=12&&h<17?"Good afternoon":h>=17&&h<21?"Good evening":"Good night"}
$("greeting").textContent=greeting();
function toast(message){$("toast").textContent=message;$("toast").style.display="block";clearTimeout(toastTimer);toastTimer=setTimeout(()=>$("toast").style.display="none",3200)}
function dateValue(v){if(!v)return "—";if(typeof v==="string")return v;try{if(v.toDate)return v.toDate().toLocaleString("en-LK",{timeZone:"Asia/Colombo"});return new Date(v).toLocaleString("en-LK",{timeZone:"Asia/Colombo"})}catch{return "—"}}
function escapeHTML(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function showLogin(message=""){ $("loginView").classList.remove("hidden");$("appView").classList.add("hidden");$("loginStatus").textContent=message; }
function showApp(){ $("loginView").classList.add("hidden");$("appView").classList.remove("hidden");$("adminGreeting").innerHTML=`${greeting()} to <span>TechVibe!</span>`; startData(); }
function stopData(){if(stopBookings)stopBookings();if(stopReviews)stopReviews();stopBookings=stopReviews=null}
function startData(){
 stopData();
 stopBookings=onSnapshot(collection(db,"bookings"),snap=>{bookings=snap.docs.map(d=>({id:d.id,...d.data()}));bookings.sort((a,b)=>timeOf(b.createdAt)-timeOf(a.createdAt));renderBookings();renderOverview()},err=>{console.error(err);toast("Could not load bookings. Check Firestore rules.")});
 stopReviews=onSnapshot(collection(db,"reviews"),snap=>{reviews=snap.docs.map(d=>({id:d.id,...d.data()}));reviews.sort((a,b)=>timeOf(b.createdAt)-timeOf(a.createdAt));renderReviews();renderOverview()},err=>{console.error(err);toast("Could not load reviews. Check Firestore rules.")});
}
function timeOf(v){try{return v?.toMillis?v.toMillis():v?.seconds?v.seconds*1000:new Date(v||0).getTime()||0}catch{return 0}}
function renderOverview(){
 $("totalBookings").textContent=bookings.length;$("pendingBookings").textContent=bookings.filter(b=>(b.status||"Pending")==="Pending").length;
 $("totalReviews").textContent=reviews.length;$("pendingReviews").textContent=reviews.filter(r=>(r.status||"legacy")==="pending"||(r.status||"legacy")==="legacy").length;
 $("bookingCount").textContent=bookings.length+" BOOKINGS";$("reviewCount").textContent=reviews.length+" REVIEWS";
 const recent=bookings.slice(0,5);
 $("recentBookings").innerHTML=recent.length?recent.map(b=>`<div style="padding:10px 0;border-bottom:1px solid #29435e"><strong>${escapeHTML(b.customerName||"Customer")}</strong><span class="sub">${escapeHTML(b.service||"Service")} · ${escapeHTML(b.preferredDate||dateValue(b.createdAt))}</span><span class="status-badge status-${escapeHTML(b.status||"Pending")}">${escapeHTML(b.status||"Pending")}</span></div>`).join(""):'<div class="empty">No bookings received yet.</div>';
}
function renderBookings(){
 const q=$("bookingSearch").value.toLowerCase(),f=$("bookingFilter").value;
 const rows=bookings.filter(b=>{const s=(b.status||"Pending");const hay=[b.customerName,b.phone,b.service,b.address,b.message].join(" ").toLowerCase();return(!q||hay.includes(q))&&(f==="all"||s===f)});
 $("bookingRows").innerHTML=rows.length?rows.map(b=>`<tr><td><strong>${escapeHTML(b.customerName||"—")}</strong><span class="sub">${escapeHTML(b.message||"")}</span></td><td>${escapeHTML(b.service||"—")}<span class="sub">${escapeHTML(b.preferredDate||"—")} · ${escapeHTML(b.preferredTime||"")}</span></td><td>${escapeHTML(b.phone||"—")}<span class="sub">${escapeHTML(b.address||"—")}</span></td><td><span class="status-badge status-${escapeHTML(b.status||"Pending")}">${escapeHTML(b.status||"Pending")}</span></td><td><select class="filter" data-booking-status="${b.id}" aria-label="Update booking status"><option ${((b.status||"Pending")==="Pending")?"selected":""}>Pending</option><option ${b.status==="Confirmed"?"selected":""}>Confirmed</option><option ${b.status==="Completed"?"selected":""}>Completed</option><option ${b.status==="Cancelled"?"selected":""}>Cancelled</option></select></td></tr>`).join(""):'<tr><td colspan="5" class="empty">No matching bookings found.</td></tr>';
}
function reviewStatus(r){return r.status||"legacy"}
function renderReviews(){
 const q=$("reviewSearch").value.toLowerCase(),f=$("reviewFilter").value;
 const rows=reviews.filter(r=>{const s=reviewStatus(r),hay=[r.customerName,r.message].join(" ").toLowerCase();return(!q||hay.includes(q))&&(f==="all"||s===f)});
 $("reviewRows").innerHTML=rows.length?rows.map(r=>{const s=reviewStatus(r),label=s==="legacy"?"Older / Unmoderated":s[0].toUpperCase()+s.slice(1);return `<tr><td><strong>${escapeHTML(r.customerName||"Customer")}</strong><span class="sub">${escapeHTML(dateValue(r.createdAt))}</span></td><td><span style="color:var(--orange);letter-spacing:1px">${"★".repeat(Math.max(0,Math.min(5,Number(r.rating)||0)))}</span><span class="sub">${escapeHTML(r.rating||0)} / 5</span></td><td>${escapeHTML(r.message||"—")}</td><td><span class="status-badge status-${s}">${label}</span></td><td>${s!=="approved"?`<button class="action approve" data-review-action="approved" data-id="${r.id}">APPROVE</button>`:""}${s!=="rejected"?`<button class="action reject" data-review-action="rejected" data-id="${r.id}">REJECT</button>`:""}</td></tr>`}).join(""):'<tr><td colspan="5" class="empty">No matching reviews found.</td></tr>';
}
$("bookingRows").addEventListener("change",async e=>{const id=e.target.dataset.bookingStatus;if(!id)return;try{await updateDoc(doc(db,"bookings",id),{status:e.target.value});toast("Booking status updated.");}catch(err){console.error(err);toast("Update failed. Check Firestore rules.");}});
$("reviewRows").addEventListener("click",async e=>{const btn=e.target.closest("[data-review-action]");if(!btn)return;const status=btn.dataset.reviewAction,id=btn.dataset.id;btn.disabled=true;try{await updateDoc(doc(db,"reviews",id),{status});toast(status==="approved"?"Review approved.":"Review rejected.");}catch(err){console.error(err);toast("Review update failed. Check Firestore rules.");}finally{btn.disabled=false;}});
$("bookingSearch").addEventListener("input",renderBookings);$("bookingFilter").addEventListener("change",renderBookings);$("reviewSearch").addEventListener("input",renderReviews);$("reviewFilter").addEventListener("change",renderReviews);
document.querySelectorAll(".navbtn").forEach(btn=>btn.addEventListener("click",()=>{document.querySelectorAll(".navbtn").forEach(x=>x.classList.toggle("active",x===btn));document.querySelectorAll(".section").forEach(x=>x.classList.toggle("active",x.id==="page-"+btn.dataset.page));}));
function updateClock(){const now=new Date();const t=new Intl.DateTimeFormat("en-GB",{timeZone:"Asia/Colombo",hour:"2-digit",minute:"2-digit",second:"2-digit",hour12:true}).format(now);$("bigClock").textContent=t;$("topClock").textContent=t;$("dateLine").textContent=localDate.format(now);$("todayText").textContent=localDate.format(now)}
setInterval(updateClock,1000);updateClock();
function renderCalendar(){const y=calendarDate.getFullYear(),m=calendarDate.getMonth(),first=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate(),today=new Date();$("calendarTitle").textContent=calendarDate.toLocaleDateString("en-US",{month:"long",year:"numeric"});const names=["S","M","T","W","T","F","S"];let out=names.map(n=>`<span>${n}</span>`).join("");for(let i=0;i<first;i++)out+='<button disabled></button>';for(let d=1;d<=days;d++){const isToday=d===today.getDate()&&m===today.getMonth()&&y===today.getFullYear();out+=`<button class="${isToday?"today":""}" type="button">${d}</button>`}$("calendarGrid").innerHTML=out}
$("prevMonth").addEventListener("click",()=>{calendarDate.setMonth(calendarDate.getMonth()-1);renderCalendar()});$("nextMonth").addEventListener("click",()=>{calendarDate.setMonth(calendarDate.getMonth()+1);renderCalendar()});renderCalendar();
$("loginForm").addEventListener("submit",async e=>{e.preventDefault();const b=$("loginBtn");b.disabled=true;b.textContent="SIGNING IN…";$("loginStatus").textContent="";try{const credential=await signInWithEmailAndPassword(auth,$("email").value.trim(),$("password").value);if(credential.user.uid!==ADMIN_UID){await signOut(auth);showLogin("Access denied: this account is not the authorised TechVibe admin.");}}catch(err){console.error(err);$("loginStatus").textContent=err.code==="auth/invalid-credential"?"Email or password is incorrect. Use Forgot Password if needed.":err.code==="auth/api-key-not-valid"?"Firebase API key is invalid. Check Firebase Web App settings.":err.message||"Sign-in failed."}finally{b.disabled=false;b.textContent="SIGN IN SECURELY →"}});
$("resetBtn").addEventListener("click",async()=>{const email=$("email").value.trim();if(!email){$("loginStatus").textContent="Enter your admin email first.";return}const b=$("resetBtn");b.disabled=true;b.textContent="SENDING…";try{await sendPasswordResetEmail(auth,email);$("loginStatus").textContent="If the account exists, a reset email has been sent. Check Inbox and Spam."}catch(err){console.error(err);$("loginStatus").textContent="Could not send reset email. Please check the email and try again."}finally{b.disabled=false;b.textContent="Forgot Password?"}});
$("logoutBtn").addEventListener("click",async()=>{stopData();await signOut(auth);showLogin("You have signed out.")});
onAuthStateChanged(auth,user=>{if(!user){stopData();showLogin();return}if(user.uid!==ADMIN_UID){signOut(auth);showLogin("Access denied: not the authorised TechVibe admin.");return}showApp()});
</script>
